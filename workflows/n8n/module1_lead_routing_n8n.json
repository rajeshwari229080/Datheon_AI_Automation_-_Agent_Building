{
  "name": "n8n - Module 1: Lead Routing & Instant AI Qualification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "leads/intake",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Inbound Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "=Analyze and qualify this lead:\nName: {{$json.body.name}}\nCompany: {{$json.body.company}}\nBudget: {{$json.body.budget}}\nNeed: {{$json.body.business_need}}"
      },
      "id": "2",
      "name": "OpenAI Qualification",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "application": "={{$env.AIRTABLE_BASE_ID}}",
        "table": "Leads",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{$node['Webhook Inbound Lead'].json.body.name}}",
            "Company": "={{$node['Webhook Inbound Lead'].json.body.company}}",
            "Budget": "={{$node['Webhook Inbound Lead'].json.body.budget}}",
            "Score": "={{$json.lead_score}}"
          }
        }
      },
      "id": "3",
      "name": "Airtable Sync",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_DEFAULT_CHANNEL}}",
        "text": "=🎯 New Lead Ingested: {{$node['Webhook Inbound Lead'].json.body.company}} (Budget: ${{$node['Webhook Inbound Lead'].json.body.budget}})"
      },
      "id": "4",
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [760, 300]
    }
  ],
  "connections": {
    "Webhook Inbound Lead": {
      "main": [[{ "node": "OpenAI Qualification", "type": "main", "index": 0 }]]
    },
    "OpenAI Qualification": {
      "main": [[{ "node": "Airtable Sync", "type": "main", "index": 0 }]]
    },
    "Airtable Sync": {
      "main": [[{ "node": "Slack Alert", "type": "main", "index": 0 }]]
    }
  }
}
