# Enterprise AI Automation Suite - Environment Configuration Template
# Duplicate this file to .env for local configuration

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-key
HOST=127.0.0.1
PORT=8000

# Persistence (SQLite for local, PostgreSQL connection string for production)
DATABASE_URL=sqlite:///./enterprise_suite.db

# Live / Demo Mode Configuration
# When DEMO_MODE=true, mock adapters will simulate external APIs safely without keys.
DEMO_MODE=true

# AI / OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Airtable Configuration (Module 1)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Slack Configuration (Module 1 & 4)
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#enterprise-alerts

# Email Configuration (Module 2)
EMAIL_PROVIDER=mock
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Google Sheets Configuration (Module 3)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Stripe Configuration (Module 4)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_local_testing_12345
